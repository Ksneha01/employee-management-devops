
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION = 'ap-southeast-2'
        S3_BUCKET = 'amazon-bucket01373937'
        CLOUDFRONT_DISTRIBUTION_ID = 'E3BQUTRS15UI7H'
        CLOUDFRONT_URL = 'https://d34mt4khwup663.cloudfront.net'
        AWS_CREDENTIALS_ID = 'Aws-creditentials'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'GitHub checkout successful'
            }
        }

        stage('Validate Environment') {
            steps {
                sh '''
                    set -eu

                    echo "===== BUILD ENVIRONMENT ====="

                    echo "Node.js:"
                    node --version
                    which node

                    echo "npm:"
                    npm --version
                    which npm

                    echo "AWS CLI:"
                    aws --version
                    which aws

                    echo "Git:"
                    git --version

                    echo "Environment validation successful"
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh '''
                        set -eu
                        npm ci
                    '''
                }
            }
        }

        stage('Code Quality') {
            steps {
                dir('frontend') {
                    sh '''
                        set -eu
                        npm run lint
                    '''
                }
            }
        }

        stage('Build Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        set -eu
                        npm run build
                    '''
                }
            }
        }

        stage('Validate Build Artifacts') {
            steps {
                sh '''
                    set -eu

                    echo "Validating production build..."

                    test -s frontend/dist/index.html

                    echo "Production build verified"

                    du -sh frontend/dist
                    find frontend/dist -maxdepth 2 -type f
                '''
            }
        }

        stage('AWS Authentication') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: "${AWS_CREDENTIALS_ID}"
                ]]) {
                    sh '''
                        set -eu

                        echo "Verifying AWS identity..."

                        aws sts get-caller-identity \
                            --region "$AWS_REGION"

                        echo "AWS authentication successful"
                    '''
                }
            }
        }

        stage('Verify AWS Resources') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: "${AWS_CREDENTIALS_ID}"
                ]]) {
                    sh '''
                        set -eu

                        echo "Checking S3 bucket..."

                        aws s3api get-bucket-location \
                            --bucket "$S3_BUCKET"

                        echo "Checking CloudFront distribution..."

                        aws cloudfront get-distribution \
                            --id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --query 'Distribution.Status' \
                            --output text

                        echo "AWS resources verified"
                    '''
                }
            }
        }

        stage('Deploy Frontend to S3') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: "${AWS_CREDENTIALS_ID}"
                ]]) {
                    sh '''
                        set -eu

                        echo "Deploying React frontend to S3..."

                        aws s3 sync frontend/dist/ \
                            "s3://${S3_BUCKET}/" \
                            --delete \
                            --region "$AWS_REGION" \
                            --cache-control "public,max-age=300"

                        aws s3 cp frontend/dist/index.html \
                            "s3://${S3_BUCKET}/index.html" \
                            --region "$AWS_REGION" \
                            --cache-control "no-cache,no-store,must-revalidate" \
                            --content-type "text/html; charset=utf-8"

                        echo "S3 deployment successful"
                    '''
                }
            }
        }

        stage('CloudFront Cache Invalidation') {
            steps {
                withCredentials([[
                    $class: 'AmazonWebServicesCredentialsBinding',
                    credentialsId: "${AWS_CREDENTIALS_ID}"
                ]]) {
                    sh '''
                        set -eu

                        echo "Creating CloudFront invalidation..."

                        INVALIDATION_ID=$(aws cloudfront create-invalidation \
                            --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --paths "/*" \
                            --query 'Invalidation.Id' \
                            --output text)

                        echo "Invalidation ID: $INVALIDATION_ID"

                        echo "Waiting for invalidation completion..."

                        aws cloudfront wait invalidation-completed \
                            --distribution-id "$CLOUDFRONT_DISTRIBUTION_ID" \
                            --id "$INVALIDATION_ID"

                        echo "CloudFront invalidation completed"
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    set -eu

                    echo "Testing CloudFront URL..."

                    curl --retry 5 \
                        --retry-delay 5 \
                        --retry-all-errors \
                        -fsS "${CLOUDFRONT_URL}/" \
                        -o /dev/null

                    echo "Frontend deployment verified"
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: Frontend deployed to S3 and CloudFront!'
        }

        failure {
            echo 'FAILURE: Check Jenkins Console Output.'
        }

        always {
            echo 'Frontend CI/CD pipeline execution completed.'
        }
    }
}
